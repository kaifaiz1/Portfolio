# macOS
.DS_Store
._*

# editorer
.vscode/
.idea/

# Vercel
.vercel/

# Claude Code (lokal kjørekonfig)
.claude/

# Originalene rett fra kameraet. De ligger igjen i assets-mappa, men
# skal ikke ut på nett: 32 megapiksler og 2–4 MB stykket, til bruk som
# vises i noen hundre piksler. Nettversjonene ligger ved siden av,
# nedskalert. Slett originalene når du har dem trygt et annet sted.
assets/**/DSC*.jpg

# Alt i assets/bilder er originaler — JPG rett fra kameraet, eksporter
# fra Lightroom og RAW-filer (DNG), 2–22 MB stykket. Foto-kortet bruker
# nettversjonene i assets/bilder/web. De skal med; resten skal ikke.
assets/bilder/*
!assets/bilder/web/
# DSC-regelen over ville ellers også tatt nettversjonen av RAW-fila
!assets/bilder/web/*
